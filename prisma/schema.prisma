generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  plan             Plan     @default(FREE)
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  scans            ScannedItem[]
  wishlist         WishlistItem[]
}

model ScannedItem {
  id          String   @id @default(cuid())
  userId      String
  sourceUrl   String?
  imageUrl    String
  category    String?
  brand       String?
  description String?
  createdAt   DateTime @default(now())
  user        User             @relation(fields: [userId], references: [id])
  matches     MatchedProduct[]
}

model MatchedProduct {
  id            String   @id @default(cuid())
  scannedItemId String
  merchantName  String
  title         String
  price         Decimal
  currency      String
  url           String
  imageUrl      String
  inStock       Boolean  @default(true)
  source        Source   @default(GOOGLE_SHOPPING)
  fetchedAt     DateTime @default(now())
  scannedItem   ScannedItem @relation(fields: [scannedItemId], references: [id])
}

model WishlistItem {
  id               String    @id @default(cuid())
  userId           String
  matchedProductId String
  lastKnownPrice   Decimal
  // Prix plancher optionnel choisi par l'utilisateur. Si absent, l'alerte se
  // déclenche sur toute baisse sous lastKnownPrice (comportement par défaut).
  targetPrice      Decimal?
  // Empêche de renvoyer un email chaque jour tant que le prix reste sous le
  // seuil — remis à null si le prix repasse au-dessus (pour ré-alerter à la
  // prochaine baisse).
  alertSentAt      DateTime?
  // Dernière fois qu'une vérification (cron ou immédiate) a réellement
  // tourné pour cet article — sert à limiter la fréquence des appels
  // SerpApi (throttle immédiat, garde-fou Pro).
  priceCheckedAt   DateTime?
  // Durée de suivi choisie par l'utilisateur à la création de l'alerte
  // (1/3/6 mois max) — passé cette date, targetPrice est remis à null
  // automatiquement et l'alerte doit être réactivée manuellement.
  expiresAt                DateTime?
  expiryReminder14dSentAt  DateTime?
  expiryReminder24hSentAt  DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])
  observations     PriceObservation[]
}

// Un enregistrement par marchand accepté par le pipeline de matching
// (apps/web/src/lib/product-match.ts) à chaque vérification — permet de
// suivre l'article sur tous les marchands retrouvés, pas seulement le lien
// d'origine, et sert d'historique pour la bande de plausibilité de prix.
model PriceObservation {
  id             String   @id @default(cuid())
  wishlistItemId String
  merchantName   String
  title          String
  price          Decimal
  currency       String
  url            String
  // Passé par le pipeline de matching automatique (texte + prix + domaine +
  // corroboration) — seules les observations trusted peuvent déclencher une
  // alerte de prix.
  trusted        Boolean  @default(false)
  checkedAt      DateTime @default(now())
  wishlistItem   WishlistItem @relation(fields: [wishlistItemId], references: [id])
}

enum Plan {
  FREE
  DECOUVERTE
  ESSENTIEL
  PRO
}

enum Source {
  GOOGLE_SHOPPING
  AWIN
}
